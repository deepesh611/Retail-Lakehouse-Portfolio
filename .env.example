# Prefer `databricks auth login` over static PATs.

# DATABRICKS_HOST=https://dbc-xxxx.cloud.databricks.com
# DATABRICKS_TOKEN=

RETAIL_CATALOG=workspace
RETAIL_SCHEMA=retail_dev
